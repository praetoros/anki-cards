{
  "name": "anki-cards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run @anki-cards/web#typegen && vp check && vp run -r test && vp run @anki-cards/web#build",
    "dev": "vp run @anki-cards/web#dev",
    "build": "vp run @anki-cards/web#build",
    "start": "vp run @anki-cards/web#build && vp run @anki-cards/web#start",
    "test": "vp run -r test",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.12.1"
  }
}
